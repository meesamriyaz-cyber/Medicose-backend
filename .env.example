# Application
NODE_ENV=development
PORT=5000
FORCE_HTTPS=false
LOG_MOBILE_TRAFFIC=false

# Database
HALEEM_MEDICOSE_MONGO_URI=
MONGODB_URI=

# Desktop MongoDB mode
DESKTOP_APP=false
DESKTOP_MONGO_URI=mongodb://127.0.0.1:27018/haleem_medicose

# Authentication
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Redis / Upstash
REDIS_URL=
UPSTASH_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID_TEST=
RAZORPAY_KEY_SECRET_TEST=

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=

# Demo admin bootstrap (used only by npm run seed:demo-admin)
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_NAME=Medicose Demo Admin

# Mailtrap (only if used)
MAILTRAP_API_TOKEN=

# CORS
# Comma-separated production origins
ALLOWED_ORIGINS=
